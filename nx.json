{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "npmScope": "myparcel-prestashop",
  "workspaceLayout": {
    "appsDir": "views",
    "libsDir": "views"
  },
  "namedInputs": {
    "production": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/tsconfig.build.json",
      "{workspaceRoot}/views/js/vite-config/index.cjs",
      "{workspaceRoot}/yarn.lock",
      "{projectRoot}/*.config.*",
      "{projectRoot}/package.json",
      "{projectRoot}/src/**/*",
      "{projectRoot}/tsconfig.build.json",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/__tests__/**/*"
    ],
    "test": [
      "production",
      "{projectRoot}/**/*.spec.ts",
      "{projectRoot}/**/__tests__/**/*"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": ["production"],
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"]
    },
    "build:dev": {
      "cache": true,
      "inputs": ["production"],
      "dependsOn": ["^build:dev"],
      "outputs": ["{projectRoot}/dist"]
    },
    "test:run": {
      "cache": true,
      "inputs": ["test"]
    },
    "test:coverage": {
      "cache": true,
      "inputs": ["test"],
      "outputs": ["{projectRoot}/coverage", "{projectRoot}/junit.xml"]
    }
  },
  "parallel": 10
}
