{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "npmScope": "myparcel-prestashop",
  "workspaceLayout": {
    "appsDir": "views",
    "libsDir": "views"
  },
  "namedInputs": {
    "production": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/tsconfig.build.json",
      "{workspaceRoot}/views/js/vite-config/index.cjs",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{projectRoot}/*.config.*",
      "{projectRoot}/package.json",
      "{projectRoot}/src/**/*",
      "{projectRoot}/tsconfig.build.json",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/__tests__/**/*"
    ],
    "test": [
      "production",
      "{projectRoot}/**/*.spec.ts",
      "{projectRoot}/**/__tests__/**/*"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": [
        "production"
      ],
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "vite build"
      }
    },
    "build:dev": {
      "cache": true,
      "inputs": [
        "production"
      ],
      "dependsOn": [
        "^build:dev"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "vite build --mode development"
      }
    },
    "test:run": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "vitest run"
      },
      "cache": true,
      "inputs": [
        "test"
      ]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "vitest run --coverage"
      },
      "cache": true,
      "inputs": [
        "test"
      ],
      "outputs": [
        "{projectRoot}/coverage",
        "{projectRoot}/junit.xml"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "vitest"
      }
    }
  },
  "parallel": 10
}
